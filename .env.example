# Server
HTTP_PORT=8080

# PostgreSQL
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=eventflowdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://your_user:your_password@localhost:5432/eventflowdb?sslmode=disable

# Gateway / Load balancer
GATEWAY_PORT=8080
BACKEND_URLS=http://app1:8080,http://app2:8080,http://app3:8080
